{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Plant": {
    "ConfigPath": "data/plant.sample.json"
  },
  "Simulation": {
    "IntervalSeconds": 2,
    "RetentionHours": 24,
    "BackfillHours": 24
  },
  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api/v1",
    "EmbeddingModel": "openai/text-embedding-3-small",
    "ChatModel": "openai/gpt-4o-mini"
  },
  "Manuals": {
    "Path": "data/manuals"
  },
  "Chat": {
    "FreeQueriesPerDay": 10
  },
  "Qdrant": {
    "Collection": "manuals",
    "VectorSize": 1536
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
